#!/usr/bin/env bash
set -euo pipefail

expected_name='SpectrGen1'
expected_email='spectrgen@proton.me'

author_name="$(git var GIT_AUTHOR_IDENT | sed -E 's/^(.*) <.*$/\1/')"
author_email="$(git var GIT_AUTHOR_IDENT | sed -E 's/^.* <([^>]*)>.*$/\1/')"
committer_name="$(git var GIT_COMMITTER_IDENT | sed -E 's/^(.*) <.*$/\1/')"
committer_email="$(git var GIT_COMMITTER_IDENT | sed -E 's/^.* <([^>]*)>.*$/\1/')"

if [[ "$author_name" != "$expected_name" ||
      "$author_email" != "$expected_email" ||
      "$committer_name" != "$expected_name" ||
      "$committer_email" != "$expected_email" ]]; then
    cat >&2 <<ERROR
Commit blocked: incorrect Git identity.

Expected:
  $expected_name <$expected_email>

Detected author:
  $author_name <$author_email>

Detected committer:
  $committer_name <$committer_email>

Repair with:
  git config --local user.name "$expected_name"
  git config --local user.email "$expected_email"
ERROR
    exit 1
fi
