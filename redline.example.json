{
  "bitcoin_nodes": [
    {
      "id": "bitcoin.knots",
      "enabled": true,
      "display_alias": "Bitcoin Knots",
      "rpc_endpoint": "http://127.0.0.1:18443",
      "cookie_file": "/var/lib/bitcoin/.cookie",
      "cookie_env": "",
      "data_directory": "/var/lib/bitcoin"
    }
  ],
  "electrum_backends": [
    {
      "id": "electrum.electrs",
      "enabled": true,
      "display_alias": "Electrs",
      "endpoint": "tcp://127.0.0.1:50001",
      "timeout_ms": 5000,
      "bitcoin_component_id": "bitcoin.knots"
    },
    {
      "id": "electrum.fulcrum",
      "enabled": true,
      "display_alias": "Fulcrum",
      "endpoint": "tcp://127.0.0.1:50002",
      "timeout_ms": 5000,
      "bitcoin_component_id": "bitcoin.knots"
    }
  ],
  "electrum_thresholds": {
    "tip_warning_age_seconds": 3600,
    "tip_failure_age_seconds": 7200,
    "lag_warning_blocks": 2,
    "lag_failure_blocks": 10,
    "max_observation_skew_seconds": 30,
    "max_observation_age_seconds": 60,
    "max_future_skew_seconds": 300
  },
  "api": {
    "listen_address": "127.0.0.1:8383"
  },
  "database_path": "redline.db",
  "rpc_timeout_ms": 5000,
  "synchronization": {
    "max_tip_age_seconds": 7200,
    "min_verification_progress": 0.999,
    "max_header_lag": 2
  },
  "filesystem": {
    "warning_available_percent": 15,
    "failure_available_percent": 5
  }
}
