{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:satoshi-redline:schema:api:event:v1",
  "title": "SATOSHI//REDLINE API v1 event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "scan.started",
        "scan.probe.started",
        "scan.probe.completed",
        "scan.finding.created",
        "scan.diagnosis.created",
        "scan.completed",
        "scan.failed"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "scan_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "finding_code": {
          "type": "string",
          "minLength": 1
        },
        "diagnosis_code": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
