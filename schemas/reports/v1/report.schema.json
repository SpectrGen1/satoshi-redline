{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:satoshi-redline:schema:report:v1",
  "type":"object",
  "additionalProperties":false,
  "required":["format","schema_id","format_version","report_id","generated_at","producer","privacy","scan","coverage","probe_executions","observations","findings"],
  "properties":{
    "format":{"const":"satoshi-redline-report"},
    "schema_id":{"const":"urn:satoshi-redline:schema:report:v1"},
    "format_version":{"const":1},
    "report_id":{"type":"string"},
    "generated_at":{"type":"string","format":"date-time"},
    "producer":{"type":"object","additionalProperties":false,"required":["product_name","product_version","build_id"],"properties":{"product_name":{"type":"string"},"product_version":{"type":"string"},"build_id":{"type":"string"}}},
    "privacy":{"type":"object","additionalProperties":false,"required":["profile","validated"],"properties":{"profile":{"const":"shareable"},"validated":{"const":true}}},
    "scan":{"type":"object","additionalProperties":false,"required":["id","started_at","finished_at","status","health"],"properties":{"id":{"type":"string"},"started_at":{"type":"string"},"finished_at":{"type":"string"},"status":{"type":"string"},"health":{"enum":["healthy","warning","failure","no_conclusion"]}}},
    "coverage":{"type":"object","additionalProperties":false,"required":["state","applicable_required","assessed_required","unknown_required"],"properties":{"state":{"enum":["complete","partial","minimal","unavailable"]},"applicable_required":{"type":"integer"},"assessed_required":{"type":"integer"},"unknown_required":{"type":"integer"}}},
    "probe_executions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","probe_id","probe_version","outcome","started_at","finished_at","duration_ms"],"properties":{"id":{"type":"string"},"probe_id":{"type":"string"},"probe_version":{"type":"string"},"outcome":{"enum":["completed","partial","unavailable","failed","cancelled"]},"started_at":{"type":"string"},"finished_at":{"type":"string"},"duration_ms":{"type":"integer"},"limitation_code":{"type":"string"}}}},
    "observations":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","probe_execution_id","component_id","kind","schema_version","observed_at","capability_id","provider_id","sensitivity"],"properties":{"id":{"type":"string"},"probe_execution_id":{"type":"string"},"component_id":{"type":"string"},"kind":{"enum":["bitcoin.rpc.transport","bitcoin.chain.state","filesystem.capacity","system.clock.current"]},"schema_version":{"const":"v1"},"observed_at":{"type":"string"},"capability_id":{"type":"string"},"provider_id":{"type":"string"},"sensitivity":{"type":"string"},"bitcoin_rpc_transport":{"type":"object"},"bitcoin_chain_state":{"type":"object"},"filesystem_capacity":{"type":"object"}}}},
    "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","code","component_id","status","applicability","severity","confidence","evaluator_id","evaluator_version","evaluated_at","coverage_role","unknown_reasons","evidence","missing_evidence","thresholds"],"properties":{"id":{"type":"string"},"code":{"type":"string"},"component_id":{"type":"string"},"status":{"enum":["pass","warning","failure","unknown"]},"applicability":{"enum":["applicable","not_applicable","undetermined"]},"severity":{"enum":["none","informational","low","medium","high","critical"]},"confidence":{"enum":["low","medium","high"]},"evaluator_id":{"type":"string"},"evaluator_version":{"type":"string"},"evaluated_at":{"type":"string"},"coverage_role":{"enum":["required","optional","informational"]},"unknown_reasons":{"type":"array"},"evidence":{"type":"array"},"missing_evidence":{"type":"array"},"thresholds":{"type":"object"}},"allOf":[{"if":{"properties":{"status":{"const":"unknown"}}},"then":{"properties":{"unknown_reasons":{"minItems":1},"missing_evidence":{"minItems":1}}}}]}}
  }
