{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:satoshi-redline:schema:report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema_id", "format_version", "report_id", "generated_at",
    "producer", "privacy", "scan", "coverage", "components", "dependency_edges",
    "probe_executions", "observations", "findings", "diagnoses"
  ],
  "properties": {
    "format": {"const": "satoshi-redline-report"},
    "schema_id": {"const": "urn:satoshi-redline:schema:report:v1"},
    "format_version": {"const": 1},
    "report_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "scan": {"$ref": "#/$defs/scan"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "dependency_edges": {"type": "array", "items": {"$ref": "#/$defs/dependency_edge"}},
    "probe_executions": {"type": "array", "items": {"$ref": "#/$defs/probe_execution"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "diagnoses": {"type": "array", "items": {"$ref": "#/$defs/diagnosis"}}
  },
  "$defs": {
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["product_name", "product_version", "build_id"],
      "properties": {
        "product_name": {"type": "string", "minLength": 1},
        "product_version": {"type": "string", "minLength": 1},
        "build_id": {"type": "string", "minLength": 1}
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "validated"],
      "properties": {"profile": {"const": "shareable"}, "validated": {"const": true}}
    },
    "scan": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "started_at", "finished_at", "status", "health"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["completed"]},
        "health": {"enum": ["healthy", "warning", "failure", "no_conclusion"]}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "applicable_required", "assessed_required", "unknown_required"],
      "properties": {
        "state": {"enum": ["complete", "partial", "minimal", "unavailable"]},
        "applicable_required": {"type": "integer", "minimum": 0},
        "assessed_required": {"type": "integer", "minimum": 0},
        "unknown_required": {"type": "integer", "minimum": 0}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "component_kind", "implementation_family", "display_alias", "provenance", "state"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
        "component_kind": {"enum": ["bitcoin-node", "electrum-backend", "local-system", "filesystem"]},
        "implementation_family": {"enum": ["bitcoin", "electrum", "local-system", "filesystem"]},
        "implementation_version": {"type": "string"},
        "display_alias": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["configuration", "built_in"]},
        "state": {"enum": ["configured", "discovered"]}
      }
    },
    "dependency_edge": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "source_component_id", "destination_component_id", "relationship_kind", "provenance", "confidence", "recorded_at"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "source_component_id": {"type": "string", "minLength": 1},
        "destination_component_id": {"type": "string", "minLength": 1},
        "relationship_kind": {"const": "uses_chain_from"},
        "provenance": {"const": "configuration"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "probe_execution": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "probe_id", "probe_version", "outcome", "started_at", "finished_at", "duration_ms"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "probe_id": {"type": "string", "minLength": 1},
        "probe_version": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["completed", "partial", "unavailable", "failed", "cancelled"]},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "limitation_code": {"type": "string", "minLength": 1}
      }
    },
    "rpc_transport": {
      "type": "object", "additionalProperties": false,
      "required": ["reached", "authentication", "category"],
      "properties": {
        "reached": {"type": "boolean"},
        "authentication": {"enum": ["accepted", "rejected", "unknown"]},
        "category": {"type": "string", "minLength": 1}
      }
    },
    "chain_state": {
      "type": "object", "additionalProperties": false,
      "required": ["blocks", "headers", "verification_progress", "initial_block_download", "tip_time"],
      "properties": {
        "blocks": {"type": "integer", "minimum": 0},
        "headers": {"type": "integer", "minimum": 0},
        "verification_progress": {"type": "number", "minimum": 0, "maximum": 1},
        "initial_block_download": {"type": "boolean"},
        "tip_time": {"type": "string", "format": "date-time"}
      }
    },
    "bitcoin_block_hash": {
      "type": "object", "additionalProperties": false,
      "required": ["height", "block_hash"],
      "properties": {
        "height": {"type": "integer", "minimum": 0},
        "block_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "filesystem_capacity": {
      "type": "object", "additionalProperties": false,
      "required": ["total_bytes", "available_bytes", "read_only", "mount_present"],
      "properties": {
        "total_bytes": {"type": "integer", "minimum": 1},
        "available_bytes": {"type": "integer", "minimum": 0},
        "read_only": {"type": "boolean"},
        "mount_present": {"type": "boolean"}
      }
    },
    "clock_state": {
      "type": "object", "additionalProperties": false,
      "required": ["current_time"],
      "properties": {"current_time": {"type": "string", "format": "date-time"}}
    },
    "electrum_transport": {
      "type": "object", "additionalProperties": false,
      "required": ["reached", "transport_kind", "tls_verification", "protocol_negotiation", "category"],
      "properties": {
        "reached": {"type": "boolean"},
        "transport_kind": {"enum": ["tcp", "tls"]},
        "tls_verification": {"enum": ["not_applicable", "verified", "failed", "unknown"]},
        "protocol_negotiation": {"enum": ["accepted", "unsupported", "unknown"]},
        "category": {"type": "string", "minLength": 1}
      }
    },
    "electrum_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_family", "protocol_version"],
      "properties": {
        "implementation_family": {"enum": ["electrs", "fulcrum", "unknown"]},
        "protocol_version": {"enum": ["1.4", "1.4.1", "1.4.2", "1.4.3"]}
      }
    },
    "electrum_tip": {
      "type": "object", "additionalProperties": false,
      "required": ["height", "block_hash", "header_time"],
      "properties": {
        "height": {"type": "integer", "minimum": 0},
        "block_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "header_time": {"type": "string", "format": "date-time"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "probe_execution_id", "component_id", "kind", "schema_version", "observed_at", "capability_id", "provider_id", "sensitivity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "probe_execution_id": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["bitcoin.rpc.transport", "bitcoin.chain.state", "bitcoin.chain.block-hash", "filesystem.capacity", "system.clock.current", "electrum.protocol.transport", "electrum.server.identity", "electrum.chain.tip"]},
        "schema_version": {"const": "v1"},
        "observed_at": {"type": "string", "format": "date-time"},
        "capability_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1},
        "sensitivity": {"enum": ["none", "local_sensitive"]},
        "bitcoin_rpc_transport": {"$ref": "#/$defs/rpc_transport"},
        "bitcoin_chain_state": {"$ref": "#/$defs/chain_state"},
        "bitcoin_block_hash": {"$ref": "#/$defs/bitcoin_block_hash"},
        "filesystem_capacity": {"$ref": "#/$defs/filesystem_capacity"},
        "clock_state": {"$ref": "#/$defs/clock_state"},
        "electrum_protocol_transport": {"$ref": "#/$defs/electrum_transport"},
        "electrum_server_identity": {"$ref": "#/$defs/electrum_identity"},
        "electrum_chain_tip": {"$ref": "#/$defs/electrum_tip"}
      },
      "oneOf": [
        {"required": ["bitcoin_rpc_transport"], "properties": {"kind": {"const": "bitcoin.rpc.transport"}}, "not": {"anyOf": [{"required": ["bitcoin_chain_state"]}, {"required": ["bitcoin_block_hash"]}, {"required": ["filesystem_capacity"]}, {"required": ["clock_state"]}, {"required": ["electrum_protocol_transport"]}, {"required": ["electrum_server_identity"]}, {"required": ["electrum_chain_tip"]}]}},
        {"required": ["bitcoin_chain_state"], "properties": {"kind": {"const": "bitcoin.chain.state"}}, "not": {"anyOf": [{"required": ["bitcoin_rpc_transport"]}, {"required": ["bitcoin_block_hash"]}, {"required": ["filesystem_capacity"]}, {"required": ["clock_state"]}, {"required": ["electrum_protocol_transport"]}, {"required": ["electrum_server_identity"]}, {"required": ["electrum_chain_tip"]}]}},
        {"required": ["bitcoin_block_hash"], "properties": {"kind": {"const": "bitcoin.chain.block-hash"}}, "not": {"anyOf": [{"required": ["bitcoin_rpc_transport"]}, {"required": ["bitcoin_chain_state"]}, {"required": ["filesystem_capacity"]}, {"required": ["clock_state"]}, {"required": ["electrum_protocol_transport"]}, {"required": ["electrum_server_identity"]}, {"required": ["electrum_chain_tip"]}]}},
        {"required": ["filesystem_capacity"], "properties": {"kind": {"const": "filesystem.capacity"}}, "not": {"anyOf": [{"required": ["bitcoin_rpc_transport"]}, {"required": ["bitcoin_chain_state"]}, {"required": ["bitcoin_block_hash"]}, {"required": ["clock_state"]}, {"required": ["electrum_protocol_transport"]}, {"required": ["electrum_server_identity"]}, {"required": ["electrum_chain_tip"]}]}},
        {"required": ["clock_state"], "properties": {"kind": {"const": "system.clock.current"}}, "not": {"anyOf": [{"required": ["bitcoin_rpc_transport"]}, {"required": ["bitcoin_chain_state"]}, {"required": ["bitcoin_block_hash"]}, {"required": ["filesystem_capacity"]}, {"required": ["electrum_protocol_transport"]}, {"required": ["electrum_server_identity"]}, {"required": ["electrum_chain_tip"]}]}},
        {"required": ["electrum_protocol_transport"], "properties": {"kind": {"const": "electrum.protocol.transport"}}, "not": {"anyOf": [{"required": ["bitcoin_rpc_transport"]}, {"required": ["bitcoin_chain_state"]}, {"required": ["bitcoin_block_hash"]}, {"required": ["filesystem_capacity"]}, {"required": ["clock_state"]}, {"required": ["electrum_server_identity"]}, {"required": ["electrum_chain_tip"]}]}},
        {"required": ["electrum_server_identity"], "properties": {"kind": {"const": "electrum.server.identity"}}, "not": {"anyOf": [{"required": ["bitcoin_rpc_transport"]}, {"required": ["bitcoin_chain_state"]}, {"required": ["bitcoin_block_hash"]}, {"required": ["filesystem_capacity"]}, {"required": ["clock_state"]}, {"required": ["electrum_protocol_transport"]}, {"required": ["electrum_chain_tip"]}]}},
        {"required": ["electrum_chain_tip"], "properties": {"kind": {"const": "electrum.chain.tip"}}, "not": {"anyOf": [{"required": ["bitcoin_rpc_transport"]}, {"required": ["bitcoin_chain_state"]}, {"required": ["bitcoin_block_hash"]}, {"required": ["filesystem_capacity"]}, {"required": ["clock_state"]}, {"required": ["electrum_protocol_transport"]}, {"required": ["electrum_server_identity"]}]}}
      ]
    },
    "unknown_reason": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "stage", "retryability", "resolution_class"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "stage": {"enum": ["discovery", "capability_resolution", "collection", "normalization", "evaluation", "correlation"]},
        "retryability": {"enum": ["retryable", "not_retryable", "conditionally_retryable", "unknown"]},
        "resolution_class": {"enum": ["retry_scan", "correct_configuration", "grant_host_access", "update_redline", "manual_local_inspection", "none_known"]},
        "capability_id": {"type": "string", "minLength": 1},
        "provider_id": {"type": "string", "minLength": 1}
      }
    },
    "evidence_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "observation_kind", "role"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "observation_kind": {"enum": ["bitcoin.rpc.transport", "bitcoin.chain.state", "bitcoin.chain.block-hash", "filesystem.capacity", "system.clock.current", "electrum.protocol.transport", "electrum.server.identity", "electrum.chain.tip"]},
        "role": {"enum": ["supports", "contradicts", "bounds", "contextualizes", "establishes_dependency", "establishes_timing"]}
      }
    },
    "missing_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_kind", "problem", "reason_code"],
      "properties": {
        "observation_kind": {"enum": ["bitcoin.rpc.transport", "bitcoin.chain.state", "bitcoin.chain.block-hash", "filesystem.capacity", "system.clock.current", "electrum.protocol.transport", "electrum.server.identity", "electrum.chain.tip"]},
        "problem": {"enum": ["missing", "stale", "conflicting", "unusable"]},
        "reason_code": {"type": "string", "minLength": 1}
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": [
        "max_tip_age_seconds", "min_verification_progress", "max_header_lag",
        "warning_available_percent", "failure_available_percent",
        "electrum_tip_warning_age_seconds", "electrum_tip_failure_age_seconds",
        "electrum_lag_warning_blocks", "electrum_lag_failure_blocks",
        "max_observation_skew_seconds", "max_observation_age_seconds", "max_future_skew_seconds"
      ],
      "properties": {
        "max_tip_age_seconds": {"type": "integer", "minimum": 0},
        "min_verification_progress": {"type": "number", "minimum": 0, "maximum": 1},
        "max_header_lag": {"type": "integer", "minimum": 0},
        "warning_available_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "failure_available_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "electrum_tip_warning_age_seconds": {"type": "integer", "minimum": 0},
        "electrum_tip_failure_age_seconds": {"type": "integer", "minimum": 0},
        "electrum_lag_warning_blocks": {"type": "integer", "minimum": 0},
        "electrum_lag_failure_blocks": {"type": "integer", "minimum": 0},
        "max_observation_skew_seconds": {"type": "integer", "minimum": 0},
        "max_observation_age_seconds": {"type": "integer", "minimum": 0},
        "max_future_skew_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "code", "component_id", "status", "applicability", "severity", "confidence", "evaluator_id", "evaluator_version", "evaluated_at", "coverage_role", "unknown_reasons", "evidence", "missing_evidence", "thresholds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "warning", "failure", "unknown"]},
        "applicability": {"enum": ["applicable", "not_applicable", "undetermined"]},
        "severity": {"enum": ["none", "informational", "low", "medium", "high", "critical"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evaluator_id": {"type": "string", "minLength": 1},
        "evaluator_version": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "coverage_role": {"enum": ["required", "optional", "informational"]},
        "unknown_reasons": {"type": "array", "items": {"$ref": "#/$defs/unknown_reason"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_reference"}},
        "missing_evidence": {"type": "array", "items": {"$ref": "#/$defs/missing_evidence"}},
        "thresholds": {"$ref": "#/$defs/thresholds"}
      },
      "oneOf": [
        {
          "properties": {
            "status": {"const": "unknown"},
            "unknown_reasons": {"minItems": 1},
            "missing_evidence": {"minItems": 1}
          }
        },
        {
          "properties": {
            "status": {"enum": ["pass", "warning", "failure"]},
            "unknown_reasons": {"maxItems": 0},
            "missing_evidence": {"maxItems": 0},
            "evidence": {"minItems": 1}
          }
        }
      ]
    },
    "diagnosis": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "code", "classification", "confidence", "summary_key",
        "component_ids", "finding_ids", "evidence", "blocking_unknown_finding_ids",
        "plausible_alternative_codes", "correlation_rule_id", "correlation_rule_version", "diagnosed_at"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "classification": {"enum": ["root_cause", "break_point", "contributing_factor", "symptom_cluster", "inconclusive"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "summary_key": {"type": "string", "minLength": 1},
        "component_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_reference"}},
        "blocking_unknown_finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "plausible_alternative_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "correlation_rule_id": {"type": "string", "minLength": 1},
        "correlation_rule_version": {"type": "string", "minLength": 1},
        "diagnosed_at": {"type": "string", "format": "date-time"}
      },
      "if": {"properties": {"classification": {"const": "inconclusive"}}},
      "then": {"properties": {"blocking_unknown_finding_ids": {"minItems": 1}}}
    }
  }
}
